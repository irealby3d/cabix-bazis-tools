  <par comment="══════ АВТОР ЖАНА СИСТЕМА ══════" name="_info" type="string" expr="Cabix Smart Adaptive System"/>
  <par comment="Автор / Иштеп чыгуучу" name="developer" type="string" expr="iRealBy_3D"/>
  <par comment="Системанын версиясы" name="version" type="string" expr="v1.0 KG Ыңгайлашкан"/>
  <par comment="Лицензия" name="license" type="string" expr="Бардык укуктар корголгон (c) iRealBy_3D"/>
<par comment="[ЖӨНДӨӨ] Umumiy masshtab tuzatmasi: 1 = avto; 0.9 = hamma narsa 10% kichik; 1.1 = 10% katta" name="kadj" type="double" expr="1"/><par comment="[ЖӨНДӨӨ] QR o'lchami = etiket ichki balandligining ulushi (0.25 kichikroq, 0.32 kattaroq)" name="qrk" type="double" expr="0.35"/><par comment="[ЖӨНДӨӨ] Ikonka o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="isz0" type="double" expr="6"/><par comment="[ЖӨНДӨӨ] QR va ikonkalar orasidagi bo'shliq, mm (80x60 dagi qiymat)" name="ig0" type="double" expr="1"/><par comment="[ЖӨНДӨӨ] Chap matnlar bilan QR orasidagi zaxira, mm (matn QR ga tegsa oshiring)" name="tpad" type="double" expr="2"/><par comment="[ЖӨНДӨӨ] Yuqori kromka chizig'ining markazdan yuqoriga masofasi (k birlikda)" name="lt" type="double" expr="4.5"/><par comment="[ЖӨНДӨӨ] Pastki kromka chizig'ining markazdan pastga masofasi (k birlikda)" name="lb" type="double" expr="2.2"/><par comment="[ЖӨНДӨӨ] Matn y-ankeri: 1 = qator pastki cheti, 0 = yuqori cheti (matn chiziqqa tegsa 0 qiling)" name="ta" type="double" expr="1"/><par comment="[ЖӨНДӨӨ] Qoldiq (Остаток) etiketidagi QR o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="qrl" type="double" expr="22"/><par comment="[ТЕКСТ] Qoldiq etiketida QR yonidagi erkin matn, 1-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext1" type="string" expr="Cabix by iRealBy_3D"/><par comment="[ТЕКСТ] Qoldiq etiketida QR yonidagi erkin matn, 2-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext2" type="string"/><par comment="[ЭТАЛОН] Etalon ichki uzunlik, mm (80x60 uchun 76). O'zgartirmang" name="kw" type="double" expr="76"/><par comment="[ЭТАЛОН] Etalon ichki balandlik, mm (80x60 uchun 56). O'zgartirmang" name="kh" type="double" expr="56"/><par comment="Буюм - Коду" name="product.code" type="string"/><par comment="Бөлүк - Коду" name="part.code" type="string"/><par comment="Иштиктүү калдык" name="business" type="boolean" expr="false"/><par comment="Четтери (margin)" name="margin" type="double" expr="2"/><var comment="Файл кеңейтилиши" name="suffix" type="string" expr="''"/><par comment="Номер" name="index" type="string" expr="12"/><par comment="Буюм - Номери" name="product.index" type="string" expr="2"/><par comment="XNC Иштетүү (операция коду) 1" name="XNC1" type="string" expr="01_025_1_1"/><par comment="XNC Иштетүү (Тарабы) 1" name="xncSide1" type="boolean" expr="true"/><par comment="XNC Иштетүү (операция коду) 2" name="XNC2" type="string" expr="01_025_1_2"/><par comment="XNC Иштетүү (Тарабы) 2" name="xncSide2" type="boolean"/><var name="barcodeH" type="double" expr="9"/><var comment="Четтерисиз узундугу" name="la" type="double" expr="dx-margin*2"/><var comment="Четтерисиз узундугу" name="l1" type="double" expr="50"/><var comment="Четтерисиз узундугу" name="l2" type="double" expr="la-l1"/><var comment="Четтерисиз туурасы" name="w" type="double" expr="dy-margin*2"/><par comment="Үстүнкү жээктөө. Узундугу боюнча." name="etn" type="string" expr="ПВХ04/19"/><par comment="Үстүнкү жээктөө. Белгиси." name="ets" type="string" expr="X"/><par comment="Астыңкы жээктөө. Узундугу боюнча." name="ebn" type="string" expr="ПВХ 2/19"/><par comment="Астыңкы жээктөө. Белгиси." name="ebs" type="string" expr="X"/><par comment="Сол жактагы жээктөө. Туурасы боюнча." name="eln" type="string" expr="ПВХ04/19"/><par comment="Сол жактагы жээктөө. Белгиси." name="els" type="string" expr="X"/><par comment="Оң жактагы жээктөө. Туурасы боюнча." name="ern" type="string" expr="ПВХ 2/19"/><par comment="Үстүнкү жээктөө. Калыңдыгы." name="ett" type="double" expr="2"/><par comment="Астыңкы жээктөө. Калыңдыгы." name="ebt" type="double" expr="2"/><par comment="Сол жактагы жээктөө. Калыңдыгы." name="elt" type="double" expr="2"/><par comment="Оң жактагы жээктөө. Калыңдыгы." name="ert" type="double" expr="2"/><par comment="Оң жактагы жээктөө. Белгиси." name="ers" type="string" expr="X"/><par comment="Буюм - Аталышы" name="product.name" type="string" expr="Изделие 1"/><par comment="Долбоор - Аталышы" name="project.name" type="string" expr="Тестовый проект"/><par comment="Материал - Аталышы" name="material.name" type="string" expr="ЛДСП Дуб Феррара чёрно-коричневый"/><par comment="Бөлүктүн аталышы" name="name" type="string" expr="Наименование детали"/><par comment="Узундугу" name="length" type="double" expr="2000.5"/><par comment="Туурасы" name="width" type="double" expr="1200.25"/><par comment="Калыңдыгы" name="thick" type="double" expr="18"/><par comment="Операциядагы номери" name="indexInOperation" type="string" expr="111"/><par comment="Жалпы саны (Бөлүктөр * Буюмдар)" name="totalCount" type="integer" expr="1"/><par comment="Оюк ачуу" name="groove" type="boolean" expr="true"/><par comment="Бургулоо" name="drill" type="boolean" expr="true"/><par comment="Фрезерлөө (Радиустар)" name="mill" type="boolean" expr="true"/><par name="grafic_images" type="boolean" expr="true"/><par comment="Кош бөлүк (сшивка)" name="two_details" type="boolean" expr="false"/><par comment="Эки бөлүк" name="part.twodetails" type="boolean" expr="false"/><par comment="Чейрек (фальц)" name="rabbet" type="boolean" expr="false"/><xy comment="" enable="true" x="margin" y="margin"/><rect enable="true" x="0.05-margin" y="0.05-margin" w="dx-0.1" h="dy-0.1" strokeColor="#000000" strokeWidth="0.2" strokeDash="0" fillColor="" fillHatch="0"/><par comment="Калдык (waste)" name="waste" type="boolean" expr="false"/><var comment="Жалпы масштаб (авто). Автор: iRealBy_3D" name="k" type="double" expr="if(empty(developer),0,if(la/kw&lt;w/kh,la/kw,w/kh)*kadj)"/><var comment="QR-код өлчөмү (авто)" name="qrsz" type="double" expr="w*qrk"/><var comment="Белгиче өлчөмү (авто)" name="isz" type="double" expr="isz0*k"/><var comment="Элементтер арасындагы боштук (авто)" name="ig" type="double" expr="ig0*k"/><var comment="Калдык QR өлчөмү (авто)" name="rqs" type="double" expr="qrl*k"/><var comment="Калдык QR X (оңго такалган)" name="rqx" type="double" expr="la-rqs-3*k"/><var comment="Калдык QR Y (ылдыйга такалган)" name="rqy" type="double" expr="w-rqs-3*k"/><var comment="Калдык: QR-га чейинки текст туурасы" name="rtw" type="double" expr="la-rqs-5*k"/><var comment="Белгичелер мамычасы X" name="icx" type="double" expr="la-isz"/><var comment="QR X" name="qrx" type="double" expr="icx-ig-qrsz"/><var comment="Сол тексттин туурасы (QR-га чейин)" name="tw" type="double" expr="qrx-tpad"/><var comment="Төмөнкү QR Y" name="qy2" type="double" expr="w-qrsz"/><var comment="Бургу белгичеси Y" name="iy_drill" type="double" expr="isz+ig"/><var comment="Фреза белгичеси Y" name="iy_mill" type="double" expr="w-isz"/><var comment="Чейрек белгичеси Y" name="iy_rab" type="double" expr="iy_mill-isz-ig"/><var comment="Эки бөлүк белгичеси Y" name="iy_two" type="double" expr="iy_rab-isz-ig"/><if comment="Бөлүк же калдык" expand="true" condition="not waste"><qrcode enable="true" x="qrx+1" y="-1" sz="qrsz" text="XNC1" fillColor="#000000"/><qrcode enable="true" x="qrx+1" y="qy2" sz="qrsz" text="product.code" fillColor="#000000"/><if expand="true" condition="grafic_images"><if expand="true" condition="groove"><image enable="true" x="icx+1.5" y="0" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="drill"><image enable="true" x="icx+1.5" y="iy_drill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="mill"><image enable="true" x="icx+1.5" y="iy_mill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if condition="two_details or part.twodetails"><image enable="true" x="icx" y="iy_two" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if><if expand="true" condition="rabbet"><image enable="true" x="icx" y="iy_rab" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if></if><if comment="Үстүнкү сызык" expand="true" condition="not empty(etn)"><rect enable="true" x="1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Сол сызык" expand="true" condition="not empty(eln)"><rect enable="true" x="(la/2)+1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Астыңкы сызык" expand="true" condition="not empty(ebn)"><rect enable="true" x="1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Оң сызык" expand="true" condition="not empty(ern)"><rect enable="true" x="(la/2)+1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Арип деңгээли 1.5" expand="true" condition="k&gt;=1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Саны:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="4.275" fontBold="true" fontItalic="false" rowHeight="5.85" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="4.05" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Үстүнкү жээк" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Сол жээк" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="7.65" fontBold="true" fontItalic="true" rowHeight="7.2" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Астыңкы жээк" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Оң жээк" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-5.75*k+(ta-1)*4.2*k" w="tw" text="'Scan Me --&gt;&gt; App &gt;&gt;&gt;&gt;&gt;'" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-0.5*k+(ta-1)*3.0*k" w="tw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="false" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if condition="not grafic_images"><text enable="true" x="icx" y="0+isz+(ta-1)*4.5*k" w="isz" text="if(groove,'О','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_drill+isz+(ta-1)*4.5*k" w="isz" text="if(drill,'Б','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_mill+isz+(ta-1)*4.5*k" w="isz" text="if(mill,'Ф','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/></if></if><if comment="Арип деңгээли 1.25" expand="true" condition="k&gt;=1.25 and k&lt;1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Саны:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="3.562" fontBold="true" fontItalic="false" rowHeight="4.875" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+