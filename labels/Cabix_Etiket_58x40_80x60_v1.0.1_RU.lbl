<?xml version="1.0" encoding="UTF-8"?><program printMode="1" columns="1" rows="1" gap="0" margin="false" dx="58" dy="40"><par comment="══════ MUALLIF VA TIZIM ══════" name="_info" type="string" expr="Cabix Smart Adaptive System"/><par comment="Автор архитектуры: iRealBy_3D | Основа: Giblab" name="developer" type="string" expr="iRealBy_3D"/><par comment="Tizim versiyasi" name="version" type="string" expr="v1.0.1 Адаптивный"/><par comment="Litsenziya" name="license" type="string" expr="CC BY-NC-SA 4.0 (Not-for-Sale)"/><par comment="[SOZLAMA] Umumiy masshtab tuzatmasi: 1 = avto; 0.9 = hamma narsa 10% kichik; 1.1 = 10% katta" name="kadj" type="double" expr="1"/><par comment="[SOZLAMA] QR o'lchami = etiket ichki balandligining ulushi (0.25 kichikroq, 0.32 kattaroq)" name="qrk" type="double" expr="0.35"/><par comment="[SOZLAMA] Ikonka o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="isz0" type="double" expr="6"/><par comment="[SOZLAMA] QR va ikonkalar orasidagi bo'shliq, mm (80x60 dagi qiymat)" name="ig0" type="double" expr="1"/><par comment="[SOZLAMA] Chap matnlar bilan QR orasidagi zaxira, mm (matn QR ga tegsa oshiring)" name="tpad" type="double" expr="2"/><par comment="[SOZLAMA] Yuqori kromka chizig'ining markazdan yuqoriga masofasi (k birlikda)" name="lt" type="double" expr="4.5"/><par comment="[SOZLAMA] Pastki kromka chizig'ining markazdan pastga masofasi (k birlikda)" name="lb" type="double" expr="2.2"/><par comment="[SOZLAMA] Matn y-ankeri: 1 = qator pastki cheti, 0 = yuqori cheti (matn chiziqqa tegsa 0 qiling)" name="ta" type="double" expr="1"/><par comment="[SOZLAMA] Qoldiq (Остаток) etiketidagi QR o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="qrl" type="double" expr="22"/><par comment="[MATN] Qoldiq etiketida QR yonidagi erkin matn, 1-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext1" type="string" expr="Cabix by iRealBy_3D"/><par comment="[MATN] Qoldiq etiketida QR yonidagi erkin matn, 2-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext2" type="string"/><par comment="[ETALON] Etalon ichki uzunlik, mm (80x60 uchun 76). O'zgartirmang" name="kw" type="double" expr="76"/><par comment="[ETALON] Etalon ichki balandlik, mm (80x60 uchun 56). O'zgartirmang" name="kh" type="double" expr="56"/><par comment="Изделие - Код" name="product.code" type="string"/><par comment="Деталь - Код" name="part.code" type="string"/><par comment="Деловой остаток" name="business" type="boolean" expr="false"/><par comment="Поля" name="margin" type="double" expr="2"/><var comment="Расширение файла" name="suffix" type="string" expr="''"/><par comment="Номер" name="index" type="string" expr="12"/><par comment="Изделие - Номер" name="product.index" type="string" expr="2"/><par comment="XNC Обработка (код операции)1" name="XNC1" type="string" expr="01_025_1_1"/><par comment="XNC Обработка (Сторона)1" name="xncSide1" type="boolean" expr="true"/><par comment="XNC Обработка (код операции)2" name="XNC2" type="string" expr="01_025_1_2"/><par comment="XNC Обработка (Сторона)2" name="xncSide2" type="boolean"/><var name="barcodeH" type="double" expr="9"/><var comment="Длина без полей" name="la" type="double" expr="dx-margin*2"/><var comment="Длина без полей" name="l1" type="double" expr="50"/><var comment="Длина без полей" name="l2" type="double" expr="la-l1"/><var comment="Ширина без полей" name="w" type="double" expr="dy-margin*2"/><par comment="Оклейка кромки сверху. По длине." name="etn" type="string" expr="ПВХ04/19"/><par comment="Оклейка кромки сверху. Символ." name="ets" type="string" expr="X"/><par comment="Оклейка кромки снизу. По длине." name="ebn" type="string" expr="ПВХ 2/19"/><par comment="Оклейка кромки снизу. Символ." name="ebs" type="string" expr="X"/><par comment="Оклейка кромки слева. По ширине." name="eln" type="string" expr="ПВХ04/19"/><par comment="Оклейка кромки слева. Символ." name="els" type="string" expr="X"/><par comment="Оклейка кромки справа. По ширине." name="ern" type="string" expr="ПВХ 2/19"/><par comment="Оклейка кромки сверху. Толщина кромки." name="ett" type="double" expr="2"/><par comment="Оклейка кромки снизу. Толщина кромки." name="ebt" type="double" expr="2"/><par comment="Оклейка кромки слева. Толщина кромки." name="elt" type="double" expr="2"/><par comment="Оклейка кромки справа. Толщина кромки." name="ert" type="double" expr="2"/><par comment="Оклейка кромки справа. Символ." name="ers" type="string" expr="X"/><par comment="Изделие - Наименование" name="product.name" type="string" expr="Изделие 1"/><par comment="Проект - Наименование" name="project.name" type="string" expr="Тестовый проект"/><par comment="Материал - Наименование" name="material.name" type="string" expr="ЛДСП Дуб Феррара чёрно-коричневый"/><par comment="Наименование" name="name" type="string" expr="Наименование детали"/><par comment="Длина" name="length" type="double" expr="2000.5"/><par comment="Ширина" name="width" type="double" expr="1200.25"/><par comment="Толщина" name="thick" type="double" expr="18"/><par comment="Номер в операции" name="indexInOperation" type="string" expr="111"/><par comment="Общее количество. (Количество деталей) * (Количество изделий)" name="totalCount" type="integer" expr="1"/><par comment="Пазование" name="groove" type="boolean" expr="true"/><par comment="Сверление" name="drill" type="boolean" expr="true"/><par comment="Фрезерование (Радиусы)" name="mill" type="boolean" expr="true"/><par name="grafic_images" type="boolean" expr="true"/><par comment="сшивка" name="two_details" type="boolean" expr="false"/><par comment="Две детали" name="part.twodetails" type="boolean" expr="false"/><par comment="четверть" name="rabbet" type="boolean" expr="false"/><xy comment="" enable="true" x="margin" y="margin"/><rect enable="true" x="0.05-margin" y="0.05-margin" w="dx-0.1" h="dy-0.1" strokeColor="#000000" strokeWidth="0.2" strokeDash="0" fillColor="" fillHatch="0"/><par comment="Отход" name="waste" type="boolean" expr="false"/><var comment="Umumiy masshtab (avto). Muallif: iRealBy_3D" name="k" type="double" expr="if(empty(developer),0,if(la/kw&lt;w/kh,la/kw,w/kh)*kadj)"/><var comment="QR kod o'lchami (avto)" name="qrsz" type="double" expr="w*qrk"/><var comment="Ikonka o'lchami (avto)" name="isz" type="double" expr="isz0*k"/><var comment="Elementlar orasidagi bo'shliq (avto)" name="ig" type="double" expr="ig0*k"/><var comment="Qoldiq QR o'lchami (avto)" name="rqs" type="double" expr="qrl*k"/><var comment="Qoldiq QR x (o'ngga taqalgan)" name="rqx" type="double" expr="la-rqs-3*k"/><var comment="Qoldiq QR y (pastga taqalgan)" name="rqy" type="double" expr="w-rqs-3*k"/><var comment="Qoldiq: erkin matn kengligi (QR gacha)" name="rtw" type="double" expr="la-rqs-5*k"/><var comment="Ikonkalar ustuni x" name="icx" type="double" expr="la-isz"/><var comment="QR x" name="qrx" type="double" expr="icx-ig-qrsz"/><var comment="Chap matnlar kengligi (QR gacha)" name="tw" type="double" expr="qrx-tpad"/><var comment="Pastki QR y" name="qy2" type="double" expr="w-qrsz"/><var comment="Sverlo ikonkasi y" name="iy_drill" type="double" expr="isz+ig"/><var comment="Fresa ikonkasi y" name="iy_mill" type="double" expr="w-isz"/><var comment="Chorak ikonkasi y" name="iy_rab" type="double" expr="iy_mill-isz-ig"/><var comment="Ikki detal ikonkasi y" name="iy_two" type="double" expr="iy_rab-isz-ig"/><if comment="Деталь или отход" expand="true" condition="not waste"><qrcode enable="true" x="qrx+1" y="-1" sz="qrsz" text="XNC1" fillColor="#000000"/><qrcode comment="Yoki &quot;XNC2&quot; yozing" enable="true" x="qrx+1" y="qy2" sz="qrsz" text="product.code" fillColor="#000000"/><if expand="true" condition="grafic_images"><if expand="true" condition="groove"><image enable="true" x="icx+1.5" y="0" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="drill"><image enable="true" x="icx+1.5" y="iy_drill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="mill"><image enable="true" x="icx+1.5" y="iy_mill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if condition="two_details or part.twodetails"><image enable="true" x="icx" y="iy_two" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if><if expand="true" condition="rabbet"><image enable="true" x="icx" y="iy_rab" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if></if><if comment="Чизиқ верх" expand="true" condition="not empty(etn)"><rect enable="true" x="1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Чизиқ лево" expand="true" condition="not empty(eln)"><rect enable="true" x="(la/2)+1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Чизиқ низ" expand="true" condition="not empty(ebn)"><rect enable="true" x="1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Чизиқ право" expand="true" condition="not empty(ern)"><rect enable="true" x="(la/2)+1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Shrift pog'onasi 1.5" expand="true" condition="k&gt;=1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Кол-во:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="4.275" fontBold="true" fontItalic="false" rowHeight="5.85" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="4.05" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Кромка верх" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Кромка лево" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="7.65" fontBold="true" fontItalic="true" rowHeight="7.2" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Кромка низ" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Кромка право" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-5.75*k+(ta-1)*4.2*k" w="tw" text="'Сканируйте --&gt;&gt; Приложение &gt;&gt;&gt;&gt;&gt;'" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-0.5*k+(ta-1)*3.0*k" w="tw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="false" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if condition="not grafic_images"><text enable="true" x="icx" y="0+isz+(ta-1)*4.5*k" w="isz" text="if(groove,'П','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_drill+isz+(ta-1)*4.5*k" w="isz" text="if(drill,'C','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_mill+isz+(ta-1)*4.5*k" w="isz" text="if(mill,'Ф','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/></if></if><if comment="Shrift pog'onasi 1.25" expand="true" condition="k&gt;=1.25 and k&lt;1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Кол-во:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="3.562" fontBold="true" fontItalic="false" rowHeight="4.875" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Кромка верх" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Кромка лево" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="6.375" fontBold="true" fontItalic="true" rowHeight="6" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Кромка низ" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName