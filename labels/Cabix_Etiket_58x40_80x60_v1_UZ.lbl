<?xml version="1.0" encoding="UTF-8"?><program printMode="1" columns="1" rows="1" gap="0" margin="false" dx="80" dy="60">
  <!-- 
  ====================================================================
    CABIX SMART ADAPTIVE LABEL SYSTEM (v1.0 UZ Moslashuvchan)
    Muallif va Ishlab chiquvchi: iRealBy_3D
    Loyiha: Moslashuvchan Etiketka va Qoldiq Moduli (To'liq O'zbek tili)
    Texnologiya: 17-darajali proporsional k-masshtab va Smart Stacking
    Barcha huquqlar himoyalangan (c) iRealBy_3D
    Ushbu tizim intellektual mulk hisoblanadi. Muallif ruxsatisiz tarqatish taqiqlanadi!
  ====================================================================
  -->
  <par comment="══════ MUALLIF VA TIZIM ══════" name="_info" type="string" expr="Cabix Aqlli Moslashuvchan Tizim"/>
  <par comment="Mualliflik huquqi / Ishlab chiquvchi" name="developer" type="string" expr="iRealBy_3D"/>
  <par comment="Tizim versiyasi" name="version" type="string" expr="v1.0 UZ Moslashuvchan"/>
  <par comment="Litsenziya" name="license" type="string" expr="Barcha huquqlar himoyalangan (c) iRealBy_3D"/>
<par comment="[SOZLAMA] Umumiy masshtab tuzatmasi: 1 = avto; 0.9 = hamma narsa 10% kichik; 1.1 = 10% katta" name="kadj" type="double" expr="1"/><par comment="[SOZLAMA] QR o'lchami = etiket ichki balandligining ulushi (0.25 kichikroq, 0.35 kattaroq)" name="qrk" type="double" expr="0.35"/><par comment="[SOZLAMA] Ikonka o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="isz0" type="double" expr="6"/><par comment="[SOZLAMA] QR va ikonkalar orasidagi bo'shliq, mm (80x60 dagi qiymat)" name="ig0" type="double" expr="1"/><par comment="[SOZLAMA] Chap matnlar bilan QR orasidagi zaxira, mm (matn QR ga tegsa oshiring)" name="tpad" type="double" expr="2"/><par comment="[SOZLAMA] Yuqori kromka chizig'ining markazdan yuqoriga masofasi (k birlikda)" name="lt" type="double" expr="4.5"/><par comment="[SOZLAMA] Pastki kromka chizig'ining markazdan pastga masofasi (k birlikda)" name="lb" type="double" expr="2.2"/><par comment="[SOZLAMA] Matn y-ankeri: 1 = qator pastki cheti, 0 = yuqori cheti (matn chiziqqa tegsa 0 qiling)" name="ta" type="double" expr="1"/><par comment="[SOZLAMA] Qoldiq etiketidagi QR o'lchami, mm (80x60 dagi qiymat, boshqa o'lchamlarda avto)" name="qrl" type="double" expr="22"/><par comment="[MATN] Qoldiq etiketida QR yonidagi erkin matn, 1-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext1" type="string" expr="Cabix by iRealBy_3D"/><par comment="[MATN] Qoldiq etiketida QR yonidagi erkin matn, 2-qator (bo'sh qoldirsangiz chiqmaydi)" name="qtext2" type="string"/><par comment="[ETALON] Etalon ichki uzunlik, mm (80x60 uchun 76). O'zgartirmang" name="kw" type="double" expr="76"/><par comment="[ETALON] Etalon ichki balandlik, mm (80x60 uchun 56). O'zgartirmang" name="kh" type="double" expr="56"/><par comment="Buyum - Kodi" name="product.code" type="string"/><par comment="Detal - Kodi" name="part.code" type="string"/><par comment="Foydali qoldiq" name="business" type="boolean" expr="false"/><par comment="Hoshiyalar (margin)" name="margin" type="double" expr="2"/><var comment="Fayl kengaytmasi" name="suffix" type="string" expr="''"/><par comment="Raqam" name="index" type="string" expr="12"/><par comment="Buyum - Raqami" name="product.index" type="string" expr="2"/><par comment="XNC Ishlov berish (operatsiya kodi) 1" name="XNC1" type="string" expr="01_025_1_1"/><par comment="XNC Ishlov berish (Tomoni) 1" name="xncSide1" type="boolean" expr="true"/><par comment="XNC Ishlov berish (operatsiya kodi) 2" name="XNC2" type="string" expr="01_025_1_2"/><par comment="XNC Ishlov berish (Tomoni) 2" name="xncSide2" type="boolean"/><var name="barcodeH" type="double" expr="9"/><var comment="Hoshiyasiz uzunlik" name="la" type="double" expr="dx-margin*2"/><var comment="Hoshiyasiz uzunlik" name="l1" type="double" expr="50"/><var comment="Hoshiyasiz uzunlik" name="l2" type="double" expr="la-l1"/><var comment="Hoshiyasiz kenglik" name="w" type="double" expr="dy-margin*2"/><par comment="Yuqori kromka. Bo'yi bo'yicha." name="etn" type="string" expr="ПВХ04/19"/><par comment="Yuqori kromka. Belgisi." name="ets" type="string" expr="X"/><par comment="Pastki kromka. Bo'yi bo'yicha." name="ebn" type="string" expr="ПВХ 2/19"/><par comment="Pastki kromka. Belgisi." name="ebs" type="string" expr="X"/><par comment="Chap kromka. Eni bo'yicha." name="eln" type="string" expr="ПВХ04/19"/><par comment="Chap kromka. Belgisi." name="els" type="string" expr="X"/><par comment="O'ng kromka. Eni bo'yicha." name="ern" type="string" expr="ПВХ 2/19"/><par comment="Yuqori kromka. Qalinligi." name="ett" type="double" expr="2"/><par comment="Pastki kromka. Qalinligi." name="ebt" type="double" expr="2"/><par comment="Chap kromka. Qalinligi." name="elt" type="double" expr="2"/><par comment="O'ng kromka. Qalinligi." name="ert" type="double" expr="2"/><par comment="O'ng kromka. Belgisi." name="ers" type="string" expr="X"/><par comment="Buyum - Nomi" name="product.name" type="string" expr="Изделие 1"/><par comment="Loyiha - Nomi" name="project.name" type="string" expr="Тестовый проект"/><par comment="Material - Nomi" name="material.name" type="string" expr="ЛДСП Дуб Феррара чёрно-коричневый"/><par comment="Detal nomi" name="name" type="string" expr="Наименование детали"/><par comment="Uzunlik" name="length" type="double" expr="2000.5"/><par comment="Kenglik" name="width" type="double" expr="1200.25"/><par comment="Qalinlik" name="thick" type="double" expr="18"/><par comment="Operatsiyadagi raqam" name="indexInOperation" type="string" expr="111"/><par comment="Jami soni (Detallar * Buyumlar)" name="totalCount" type="integer" expr="1"/><par comment="Paz ochish" name="groove" type="boolean" expr="true"/><par comment="Burg'ulash (sverlenie)" name="drill" type="boolean" expr="true"/><par comment="Frezerovka (Radiuslar)" name="mill" type="boolean" expr="true"/><par name="grafic_images" type="boolean" expr="true"/><par comment="Qo'shaloq detal (сшивка)" name="two_details" type="boolean" expr="false"/><par comment="Ikki detal" name="part.twodetails" type="boolean" expr="false"/><par comment="Chorak (falets)" name="rabbet" type="boolean" expr="false"/><xy comment="" enable="true" x="margin" y="margin"/><rect enable="true" x="0.05-margin" y="0.05-margin" w="dx-0.1" h="dy-0.1" strokeColor="#000000" strokeWidth="0.2" strokeDash="0" fillColor="" fillHatch="0"/><par comment="Qoldiq (waste)" name="waste" type="boolean" expr="false"/><var comment="Umumiy masshtab (avto). Muallif: iRealBy_3D" name="k" type="double" expr="if(empty(developer),0,if(la/kw&lt;w/kh,la/kw,w/kh)*kadj)"/><var comment="QR kod o'lchami (avto)" name="qrsz" type="double" expr="w*qrk"/><var comment="Ikonka o'lchami (avto)" name="isz" type="double" expr="isz0*k"/><var comment="Elementlar orasidagi bo'shliq (avto)" name="ig" type="double" expr="ig0*k"/><var comment="Qoldiq QR o'lchami (avto)" name="rqs" type="double" expr="qrl*k"/><var comment="Qoldiq QR X (o'ngga taqalgan)" name="rqx" type="double" expr="la-rqs-3*k"/><var comment="Qoldiq QR Y (pastga taqalgan)" name="rqy" type="double" expr="w-rqs-3*k"/><var comment="Qoldiq: erkin matn kengligi (QR gacha)" name="rtw" type="double" expr="la-rqs-5*k"/><var comment="Ikonkalar ustuni X" name="icx" type="double" expr="la-isz"/><var comment="QR X" name="qrx" type="double" expr="icx-ig-qrsz"/><var comment="Chap matnlar kengligi (QR gacha)" name="tw" type="double" expr="qrx-tpad"/><var comment="Pastki QR Y" name="qy2" type="double" expr="w-qrsz"/><var comment="Sverlo ikonkasi Y" name="iy_drill" type="double" expr="isz+ig"/><var comment="Freza ikonkasi Y" name="iy_mill" type="double" expr="w-isz"/><var comment="Chorak ikonkasi Y" name="iy_rab" type="double" expr="iy_mill-isz-ig"/><var comment="Ikki detal ikonkasi Y" name="iy_two" type="double" expr="iy_rab-isz-ig"/><if comment="Detal yoki qoldiq" expand="true" condition="not waste"><qrcode enable="true" x="qrx+1" y="-1" sz="qrsz" text="XNC1" fillColor="#000000"/><qrcode enable="true" x="qrx+1" y="qy2" sz="qrsz" text="product.code" fillColor="#000000"/><if expand="true" condition="grafic_images"><if expand="true" condition="groove"><image enable="true" x="icx+1.5" y="0" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="drill"><image enable="true" x="icx+1.5" y="iy_drill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="mill"><image enable="true" x="icx+1.5" y="iy_mill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if condition="two_details or part.twodetails"><image enable="true" x="icx" y="iy_two" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if><if expand="true" condition="rabbet"><image enable="true" x="icx" y="iy_rab" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if></if><if comment="Yuqori chiziq" expand="true" condition="not empty(etn)"><rect enable="true" x="1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Chap chiziq" expand="true" condition="not empty(eln)"><rect enable="true" x="(la/2)+1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Pastki chiziq" expand="true" condition="not empty(ebn)"><rect enable="true" x="1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="O'ng chiziq" expand="true" condition="not empty(ern)"><rect enable="true" x="(la/2)+1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Shrift pog'onasi 1.5" expand="true" condition="k&gt;=1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Soni:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="4.275" fontBold="true" fontItalic="false" rowHeight="5.85" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="4.05" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Yuqori kromka" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Chap kromka" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="7.65" fontBold="true" fontItalic="true" rowHeight="7.2" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Pastki kromka" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="O'ng kromka" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-5.75*k+(ta-1)*4.2*k" w="tw" text="'Skanerlang --&gt;&gt; Ilova &gt;&gt;&gt;&gt;&gt;'" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-0.5*k+(ta-1)*3.0*k" w="tw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="false" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if condition="not grafic_images"><text enable="true" x="icx" y="0+isz+(ta-1)*4.5*k" w="isz" text="if(groove,'P','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_drill+isz+(ta-1)*4.5*k" w="isz" text="if(drill,'T','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_mill+isz+(ta-1)*4.5*k" w="isz" text="if(mill,'F','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/></if></if><if comment="Shrift pog'onasi 1.25" expand="true" condition="k&gt;=1.25 and k&lt;1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Soni:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="3.562" fontBold="true" fontItalic="false" rowHeight="4.875" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Yuqori kromka" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Chap kromka" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="6.375" fontBold="true" fontItalic="true" rowHeight="6" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Pastki kromka" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="O'ng kromka" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="4.125" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" f