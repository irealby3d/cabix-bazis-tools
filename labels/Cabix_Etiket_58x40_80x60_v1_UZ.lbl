  <text enable="true" x="1" y="3*k+(ta-1)*3*k" w="la-2" text="'L:'+if(empty(project.name),'',project.name)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 2. Material nomi -->
  <text enable="true" x="1" y="7.5*k+(ta-1)*3*k" w="la-2" text="'M:'+if(empty(material.name),'',material.name)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 3. Qoldiq sarlavhasi (Foydali qoldiq yoki Qoldiq) -->
  <if expand="true" condition="business">
    <text enable="true" x="1" y="13.5*k+(ta-1)*4*k" w="la-2" text="'Foydali qoldiq'" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="4" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/>
  </if>
  <else expand="true">
    <text enable="true" x="1" y="13.5*k+(ta-1)*4*k" w="la-2" text="'Qoldiq'" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="4" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/>
  </else>
  <!-- 4. O'lchamlari (Uzunlik x Kenglik x Qalinlik) -->
  <text enable="true" x="1" y="19.5*k+(ta-1)*3.8*k" w="la-2" text="'O:'+format('0.##',length)+' x '+format('0.##',width)+if(empty(thick),'',' x '+format('0.##',thick))" fillColor="#000000" fontName="Arial" fontSize="4.2" fontBold="true" fontItalic="false" rowHeight="3.8" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 5. Operatsiyadagi raqami va Soni -->
  <text enable="true" x="1" y="25.5*k+(ta-1)*3.2*k" w="rtw/2" text="'№:'+if(empty(indexInOperation),'',indexInOperation)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <text enable="true" x="rtw/2+2" y="25.5*k+(ta-1)*3.2*k" w="rtw/2" text="'S:'+if(empty(totalCount),'',totalCount)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 6. Sana va vaqt -->
  <text enable="true" x="1" y="31*k+(ta-1)*2.4*k" w="rtw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="2.5" fontBold="false" fontItalic="false" rowHeight="2.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 7. Erkin matn 1 -->
  <text enable="true" x="1" y="35.5*k+(ta-1)*2.6*k" w="rtw" text="qtext1" fillColor="#000000" fontName="Arial" fontSize="2.8" fontBold="true" fontItalic="false" rowHeight="2.6" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 8. Erkin matn 2 -->
  <text enable="true" x="1" y="39.5*k+(ta-1)*2.6*k" w="rtw" text="qtext2" fillColor="#000000" fontName="Arial" fontSize="2.8" fontBold="true" fontItalic="false" rowHeight="2.6" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 9. QR Kod (o'ng pastki burchakda) -->
  <qrcode enable="true" x="rqx" y="rqy" sz="rqs" text="if(empty(product.code),indexInOperation,product.code)" fillColor="#000000"/>
</else></program>