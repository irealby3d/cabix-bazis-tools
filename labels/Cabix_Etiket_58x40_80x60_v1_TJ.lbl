ment="Канори рост" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="0.99" fontBold="true" fontItalic="false" rowHeight="1.08" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" fontSize="1.08" fontBold="true" fontItalic="false" rowHeight="1.26" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-5.75*k+(ta-1)*4.2*k" w="tw" text="'Скан кунед --&gt;&gt; Барнома &gt;&gt;&gt;&gt;&gt;'" fillColor="#000000" fontName="Arial" fontSize="1.08" fontBold="true" fontItalic="false" rowHeight="1.26" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-0.5*k+(ta-1)*3.0*k" w="tw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="0.675" fontBold="false" fontItalic="false" rowHeight="0.9" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if condition="not grafic_images"><text enable="true" x="icx" y="0+isz+(ta-1)*4.5*k" w="isz" text="if(groove,'Ф','')" fillColor="#000000" fontName="Arial" fontSize="1.8" fontBold="true" fontItalic="false" rowHeight="1.35" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_drill+isz+(ta-1)*4.5*k" w="isz" text="if(drill,'П','')" fillColor="#000000" fontName="Arial" fontSize="1.8" fontBold="true" fontItalic="false" rowHeight="1.35" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_mill+isz+(ta-1)*4.5*k" w="isz" text="if(mill,'Т','')" fillColor="#000000" fontName="Arial" fontSize="1.8" fontBold="true" fontItalic="false" rowHeight="1.35" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/></if></if></if><else expand="true">
  <!-- ===== БЛОКИ БОҚИМОНДА ВА БОҚИМОНДАИ КОРӢ (Муаллиф: iRealBy_3D) ===== -->
  <!-- 1. Номи лоиҳа -->
  <text enable="true" x="1" y="3*k+(ta-1)*3*k" w="la-2" text="'Л:'+if(empty(project.name),'',project.name)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 2. Номи мавод -->
  <text enable="true" x="1" y="7.5*k+(ta-1)*3*k" w="la-2" text="'М:'+if(empty(material.name),'',material.name)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 3. Сарлавҳаи боқимонда (Боқимондаи корӣ ё Боқимонда) -->
  <if expand="true" condition="business">
    <text enable="true" x="1" y="13.5*k+(ta-1)*4*k" w="la-2" text="'Боқимондаи корӣ'" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="4" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/>
  </if>
  <else expand="true">
    <text enable="true" x="1" y="13.5*k+(ta-1)*4*k" w="la-2" text="'Боқимонда'" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="4" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/>
  </else>
  <!-- 4. Андозаҳо (Дарозӣ x Бар x Ғафсӣ) -->
  <text enable="true" x="1" y="19.5*k+(ta-1)*3.8*k" w="la-2" text="'А:'+format('0.##',length)+' x '+format('0.##',width)+if(empty(thick),'',' x '+format('0.##',thick))" fillColor="#000000" fontName="Arial" fontSize="4.2" fontBold="true" fontItalic="false" rowHeight="3.8" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 5. Шумора дар амалиёт ва Шумора -->
  <text enable="true" x="1" y="25.5*k+(ta-1)*3.2*k" w="rtw/2" text="'№:'+if(empty(indexInOperation),'',indexInOperation)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <text enable="true" x="rtw/2+2" y="25.5*k+(ta-1)*3.2*k" w="rtw/2" text="'Ш:'+if(empty(totalCount),'',totalCount)" fillColor="#000000" fontName="Arial" fontSize="3.5" fontBold="true" fontItalic="false" rowHeight="3.2" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 6. Сана ва вақт -->
  <text enable="true" x="1" y="31*k+(ta-1)*2.4*k" w="rtw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="2.5" fontBold="false" fontItalic="false" rowHeight="2.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 7. Матнии озод 1 -->
  <text enable="true" x="1" y="35.5*k+(ta-1)*2.6*k" w="rtw" text="qtext1" fillColor="#000000" fontName="Arial" fontSize="2.8" fontBold="true" fontItalic="false" rowHeight="2.6" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 8. Матнии озод 2 -->
  <text enable="true" x="1" y="39.5*k+(ta-1)*2.6*k" w="rtw" text="qtext2" fillColor="#000000" fontName="Arial" fontSize="2.8" fontBold="true" fontItalic="false" rowHeight="2.6" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/>
  <!-- 9. QR Код (дар кунҷи рости поён) -->
  <qrcode enable="true" x="rqx" y="rqy" sz="rqs" text="if(empty(product.code),indexInOperation,product.code)" fillColor="#000000"/>
</else></program>