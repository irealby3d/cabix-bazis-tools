<?xml version="1.0" encoding="UTF-8"?><program printMode="1" columns="1" rows="1" gap="0" margin="false" dx="80" dy="60">
  <!-- 
  ====================================================================
    CABIX SMART ADAPTIVE LABEL SYSTEM (v1.0 TJ Мутобиқшаванда)
    Муаллиф ва Таҳиягар: iRealBy_3D
    Лоиҳа: Модули тамғакоғаз ва боқимондаи мутобиқшаванда (Пурра Забони тоҷикӣ)
    Технология: 17-зинагии пропорсионалии k-миқёс ва Smart Stacking
    Ҳамаи ҳуқуқҳо ҳифз шудаанд (c) iRealBy_3D
    Ин система моликияти зеҳнии муаллиф мебошад. Ҳамаи ҳуқуқҳо ҳифз шудаанд!
  ====================================================================
  -->
  <par comment="══════ МУАЛЛИФ ВА СИСТЕМА ══════" name="_info" type="string" expr="Cabix Системаи Мутобиқшавандаи Оқил"/>
  <par comment="Ҳуқуқи муаллиф / Таҳиягар" name="developer" type="string" expr="iRealBy_3D"/>
  <par comment="Версияи система" name="version" type="string" expr="v1.0 TJ Мутобиқшаванда"/>
  <par comment="Иҷозатнома" name="license" type="string" expr="Ҳамаи ҳуқуқҳо ҳифз шудаанд (c) iRealBy_3D"/>
<par comment="[ТАНЗИМОТ] Ислоҳи миқёси умумӣ: 1 = худкор; 0.9 = 10% хурдтар; 1.1 = 10% калонтар" name="kadj" type="double" expr="1"/><par comment="[ТАНЗИМОТ] Андозаи QR = ҳиссаи баландии дохилӣ (0.25 хурдтар, 0.35 калонтар)" name="qrk" type="double" expr="0.35"/><par comment="[ТАНЗИМОТ] Андозаи нишона, мм (барои 80x60 асосӣ, дар дигар андозаҳо худкор)" name="isz0" type="double" expr="6"/><par comment="[ТАНЗИМОТ] Фосилаи байни QR ва нишонаҳо, мм" name="ig0" type="double" expr="1"/><par comment="[ТАНЗИМОТ] Масофаи байни матни чап ва QR, мм" name="tpad" type="double" expr="2"/><par comment="[ТАНЗИМОТ] Хати канори боло: масофа аз марказ ба боло" name="lt" type="double" expr="4.5"/><par comment="[ТАНЗИМОТ] Хати канори поён: масофа аз марказ ба поён" name="lb" type="double" expr="2.2"/><par comment="[ТАНЗИМОТ] Лангари матн аз рӯи Y: 1 = поёни сатр, 0 = болои сатр" name="ta" type="double" expr="1"/><par comment="[ТАНЗИМОТ] Андозаи QR дар тамғакоғази боқимонда, мм" name="qrl" type="double" expr="22"/><par comment="[МАТН] Матни озод дар назди QR-и боқимонда, сатри 1" name="qtext1" type="string" expr="Cabix by iRealBy_3D"/><par comment="[МАТН] Матни озод дар назди QR-и боқимонда, сатри 2" name="qtext2" type="string"/><par comment="[ЭТАЛОН] Дарозии дохилии асосӣ, мм (76 барои 80x60). Тағйир надиҳед" name="kw" type="double" expr="76"/><par comment="[ЭТАЛОН] Баландии дохилии асосӣ, мм (56 барои 80x60). Тағйир надиҳед" name="kh" type="double" expr="56"/><par comment="Маҳсулот - Рамз" name="product.code" type="string"/><par comment="Қисм - Рамз" name="part.code" type="string"/><par comment="Боқимондаи корӣ" name="business" type="boolean" expr="false"/><par comment="Ҳошияҳо (margin)" name="margin" type="double" expr="2"/><var comment="Пасванди файл" name="suffix" type="string" expr="''"/><par comment="Рақам" name="index" type="string" expr="12"/><par comment="Маҳсулот - Рақам" name="product.index" type="string" expr="2"/><par comment="Коркарди XNC (рамзи амалиёт) 1" name="XNC1" type="string" expr="01_025_1_1"/><par comment="Коркарди XNC (Тараф) 1" name="xncSide1" type="boolean" expr="true"/><par comment="Коркарди XNC (рамзи амалиёт) 2" name="XNC2" type="string" expr="01_025_1_2"/><par comment="Коркарди XNC (Тараф) 2" name="xncSide2" type="boolean"/><var name="barcodeH" type="double" expr="9"/><var comment="Дарозӣ бе ҳошия" name="la" type="double" expr="dx-margin*2"/><var comment="Дарозӣ бе ҳошия" name="l1" type="double" expr="50"/><var comment="Дарозӣ бе ҳошия" name="l2" type="double" expr="la-l1"/><var comment="Бари бе ҳошия" name="w" type="double" expr="dy-margin*2"/><par comment="Часпонидани канор аз боло. Бо дарозӣ." name="etn" type="string" expr="ПВХ04/19"/><par comment="Часпонидани канор аз боло. Рамз." name="ets" type="string" expr="X"/><par comment="Часпонидани канор аз поён. Бо дарозӣ." name="ebn" type="string" expr="ПВХ 2/19"/><par comment="Часпонидани канор аз поён. Рамз." name="ebs" type="string" expr="X"/><par comment="Часпонидани канор аз чап. Бо бар." name="eln" type="string" expr="ПВХ04/19"/><par comment="Часпонидани канор аз чап. Рамз." name="els" type="string" expr="X"/><par comment="Часпонидани канор аз рост. Бо бар." name="ern" type="string" expr="ПВХ 2/19"/><par comment="Часпонидани канор аз боло. Ғафсӣ." name="ett" type="double" expr="2"/><par comment="Часпонидани канор аз поён. Ғафсӣ." name="ebt" type="double" expr="2"/><par comment="Часпонидани канор аз чап. Ғафсӣ." name="elt" type="double" expr="2"/><par comment="Часпонидани канор аз рост. Ғафсӣ." name="ert" type="double" expr="2"/><par comment="Часпонидани канор аз рост. Рамз." name="ers" type="string" expr="X"/><par comment="Маҳсулот - Номгӯй" name="product.name" type="string" expr="Изделие 1"/><par comment="Лоиҳа - Номгӯй" name="project.name" type="string" expr="Тестовый проект"/><par comment="Мавод - Номгӯй" name="material.name" type="string" expr="ЛДСП Дуб Феррара чёрно-коричневый"/><par comment="Номи қисм" name="name" type="string" expr="Наименование детали"/><par comment="Дарозӣ" name="length" type="double" expr="2000.5"/><par comment="Бар" name="width" type="double" expr="1200.25"/><par comment="Ғафсӣ" name="thick" type="double" expr="18"/><par comment="Рақам дар амалиёт" name="indexInOperation" type="string" expr="111"/><par comment="Шумораи умумӣ (Қисмҳо * Маҳсулот)" name="totalCount" type="integer" expr="1"/><par comment="Ковоксозӣ (паз)" name="groove" type="boolean" expr="true"/><par comment="Пармакунӣ" name="drill" type="boolean" expr="true"/><par comment="Фрезеркунӣ (Радиусҳо)" name="mill" type="boolean" expr="true"/><par name="grafic_images" type="boolean" expr="true"/><par comment="Қисми дукарата (сшивка)" name="two_details" type="boolean" expr="false"/><par comment="Ду қисм" name="part.twodetails" type="boolean" expr="false"/><par comment="Чоряк (фальц)" name="rabbet" type="boolean" expr="false"/><xy comment="" enable="true" x="margin" y="margin"/><rect enable="true" x="0.05-margin" y="0.05-margin" w="dx-0.1" h="dy-0.1" strokeColor="#000000" strokeWidth="0.2" strokeDash="0" fillColor="" fillHatch="0"/><par comment="Боқимонда (waste)" name="waste" type="boolean" expr="false"/><var comment="Миқёси умумӣ (авто). Муаллиф: iRealBy_3D" name="k" type="double" expr="if(empty(developer),0,if(la/kw&lt;w/kh,la/kw,w/kh)*kadj)"/><var comment="Андозаи QR-код (авто)" name="qrsz" type="double" expr="w*qrk"/><var comment="Андозаи нишона (авто)" name="isz" type="double" expr="isz0*k"/><var comment="Фосилаи байни элементҳо (авто)" name="ig" type="double" expr="ig0*k"/><var comment="Андозаи QR-и боқимонда (авто)" name="rqs" type="double" expr="qrl*k"/><var comment="QR-и боқимонда X (ба рост)" name="rqx" type="double" expr="la-rqs-3*k"/><var comment="QR-и боқимонда Y (ба поён)" name="rqy" type="double" expr="w-rqs-3*k"/><var comment="Боқимонда: паҳнои матн то QR" name="rtw" type="double" expr="la-rqs-5*k"/><var comment="Сутуни нишонаҳо X" name="icx" type="double" expr="la-isz"/><var comment="QR X" name="qrx" type="double" expr="icx-ig-qrsz"/><var comment="Паҳнои матни чап то QR" name="tw" type="double" expr="qrx-tpad"/><var comment="QR-и поён Y" name="qy2" type="double" expr="w-qrsz"/><var comment="Нишонаи парма Y" name="iy_drill" type="double" expr="isz+ig"/><var comment="Нишонаи фреза Y" name="iy_mill" type="double" expr="w-isz"/><var comment="Нишонаи чоряк Y" name="iy_rab" type="double" expr="iy_mill-isz-ig"/><var comment="Нишонаи ду қисм Y" name="iy_two" type="double" expr="iy_rab-isz-ig"/><if comment="Қисм ё боқимонда" expand="true" condition="not waste"><qrcode enable="true" x="qrx+1" y="-1" sz="qrsz" text="XNC1" fillColor="#000000"/><qrcode enable="true" x="qrx+1" y="qy2" sz="qrsz" text="product.code" fillColor="#000000"/><if expand="true" condition="grafic_images"><if expand="true" condition="groove"><image enable="true" x="icx+1.5" y="0" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="drill"><image enable="true" x="icx+1.5" y="iy_drill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if expand="true" condition="mill"><image enable="true" x="icx+1.5" y="iy_mill" w="isz" h="isz" imgdata="data:image/png;base64," ratio="true"/></if><if condition="two_details or part.twodetails"><image enable="true" x="icx" y="iy_two" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if><if expand="true" condition="rabbet"><image enable="true" x="icx" y="iy_rab" w="isz" h="isz" imgdata="data:image/png;base64," expr="" ratio="true"/></if></if><if comment="Хати боло" expand="true" condition="not empty(etn)"><rect enable="true" x="1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Хати чап" expand="true" condition="not empty(eln)"><rect enable="true" x="(la/2)+1" y="w/2-lt*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Хати поён" expand="true" condition="not empty(ebn)"><rect enable="true" x="1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Хати рост" expand="true" condition="not empty(ern)"><rect enable="true" x="(la/2)+1" y="w/2+lb*k" w="(la/2)-2" h="0" strokeColor="#000000" strokeWidth="0.25" strokeDash="0" fillColor="#FFFFFF" fillHatch="0"/></if><if comment="Зинаи ҳуруф 1.5" expand="true" condition="k&gt;=1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Шумора:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="4.275" fontBold="true" fontItalic="false" rowHeight="5.85" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="4.05" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Канори боло" expand="true" condition="not empty(etn)"><text enable="true" x="1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="etn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Канори чап" expand="true" condition="not empty(eln)"><text enable="true" x="(la/2)+1" y="w/2-5.25*k+(ta-1)*3.6*k" w="(la/2)-2" text="eln" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w/2+1.5*k+(ta-1)*4.8*k" w="la-4" text="format('0.##',length)+' x '+format('0.##',width)" fillColor="#000000" fontName="Arial" fontSize="7.65" fontBold="true" fontItalic="true" rowHeight="7.2" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><if comment="Канори поён" expand="true" condition="not empty(ebn)"><text enable="true" x="1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ebn" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><if comment="Канори рост" expand="true" condition="not empty(ern)"><text enable="true" x="(la/2)+1" y="w/2+6.2*k+(ta-1)*3.6*k" w="(la/2)-2" text="ern" fillColor="#000000" fontName="Courier New" fontSize="4.95" fontBold="true" fontItalic="false" rowHeight="5.4" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/></if><text enable="true" x="1" y="w-11.75*k+(ta-1)*4.2*k" w="tw" text="name" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-5.75*k+(ta-1)*4.2*k" w="tw" text="'Скан кунед --&gt;&gt; Барнома &gt;&gt;&gt;&gt;&gt;'" fillColor="#000000" fontName="Arial" fontSize="5.4" fontBold="true" fontItalic="false" rowHeight="6.3" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="w-0.5*k+(ta-1)*3.0*k" w="tw" text="now('yyyy.MM.dd HH:mm')" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="false" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if condition="not grafic_images"><text enable="true" x="icx" y="0+isz+(ta-1)*4.5*k" w="isz" text="if(groove,'Ф','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_drill+isz+(ta-1)*4.5*k" w="isz" text="if(drill,'П','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="icx" y="iy_mill+isz+(ta-1)*4.5*k" w="isz" text="if(mill,'Т','')" fillColor="#000000" fontName="Arial" fontSize="9" fontBold="true" fontItalic="false" rowHeight="6.75" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/></if></if><if comment="Зинаи ҳуруф 1.25" expand="true" condition="k&gt;=1.25 and k&lt;1.5"><text enable="true" x="1" y="1.5*k+(ta-1)*3.9*k" w="tw" text="'Шумора:'+totalCount" fillColor="#000000" fontName="Arial" fontSize="3.562" fontBold="true" fontItalic="false" rowHeight="4.875" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="5.7*k+(ta-1)*4.2*k" w="tw" text="XNC1" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="center" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="9.9*k+(ta-1)*4.2*k" w="tw" text="project.name" fillColor="#000000" fontName="Arial" fontSize="4.5" fontBold="true" fontItalic="false" rowHeight="5.25" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><text enable="true" x="1" y="14.1*k+(ta-1)*3.6*k" w="tw" text="material.name" fillColor="#000000" fontName="Arial" fontSize="3.375" fontBold="true" fontItalic="false" rowHeight="4.5" ratio="true" align="left" valign="top" multiline="false" wordBreak="false"/><if comment="Канори боло" expand="true" condition="not empty(e